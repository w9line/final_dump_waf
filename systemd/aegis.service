[Unit]
Description=Aegis transparent HTTP WAF proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=AEGIS_CONFIG=/etc/aegis/config.yaml
RuntimeDirectory=aegis
RuntimeDirectoryMode=0755
ExecStart=/opt/aegis/venv/bin/aegis-service --config /etc/aegis/config.yaml
Restart=always
RestartSec=1
KillMode=mixed
TimeoutStopSec=10
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/run/aegis /var/lib/aegis
PrivateTmp=true

[Install]
WantedBy=multi-user.target
